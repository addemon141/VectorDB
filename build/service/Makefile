	cd /home/addemon/VectorDB/VectorDB/build && $(MAKE) $(MAKESILENT) -f service/CMakeFiles/raft_log_test.dir/build.make service/CMakeFiles/raft_log_test.dir/tests/raft_log_test.cc.o
.PHONY : tests/raft_log_test.cc.o

